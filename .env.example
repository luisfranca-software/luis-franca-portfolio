# Environment configuration template.
# Copy to .env and fill with environment-specific values.
# Never commit real values. Categories per 06-deployment-and-operations.md (12.2, 12.3).

# Application settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Database connectivity
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Email provider credentials (Brevo SMTP per ADR-004)
# Provider: Brevo. Host: smtp-relay.brevo.com, port 587, TLS.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Contact module (SPEC-002 / ADR-004)
CONTACT_RETENTION_DAYS=90

# Public professional links (presentation configuration per ARCH-001 16.3)
WHATSAPP_CONTACT_URL=
LINKEDIN_PROFILE_URL=
GITHUB_PROFILE_URL=
RESUME_URL=
