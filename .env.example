# Environment configuration template.
# Copy to .env and fill with environment-specific values.
# Never commit real values. Categories per 06-deployment-and-operations.md (12.2, 12.3).

# Application settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Database connectivity
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Email provider credentials (Brevo SMTP per ADR-004)
# Provider: Brevo. Host: smtp-relay.brevo.com, port 587, TLS.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Contact module (SPEC-002 / ADR-004)
CONTACT_RETENTION_DAYS=90

# IA Jujuju Assistant (Release 2 Day 4 / ADR-007 / SPEC-005)
# OPENAI_API_KEY is reused from knowledge configuration below.
ASSISTANT_MODEL=gpt-5.6-luna
ASSISTANT_OPENAI_TIMEOUT=30
ASSISTANT_OPENAI_MAX_RETRIES=3
ASSISTANT_MAX_OUTPUT_TOKENS=512
ASSISTANT_CONTEXT_CHARS=4000
ASSISTANT_TOP_K=5
ASSISTANT_MAX_QUESTION_LENGTH=500
ASSISTANT_RETENTION_DAYS=90
ASSISTANT_ABUSE_WINDOW_SECONDS=60
ASSISTANT_ABUSE_MAX_REQUESTS=10

# Public professional links (presentation configuration per ARCH-001 16.3)
WHATSAPP_CONTACT_URL=
LINKEDIN_PROFILE_URL=
GITHUB_PROFILE_URL=
RESUME_URL=
